---
// Pantalla de transición entre módulos (como los separadores de la presentación)
import Split from './Split.astro';
interface Props {
  id: string;
  n: string;
  titulo: string;
  pregunta: string;
  terminal: string;
  color?: string;
}
const { id, n, titulo, pregunta, terminal } = Astro.props;
const barras = [3, 1, 2, 1, 4, 1, 1, 3, 2, 1, 1, 2, 4, 1, 2, 1, 3, 1, 1, 2, 1, 4, 2, 1, 1, 3];
---

<section id={id} class="module">
  <div class="top mono">
    <span class="caret" data-type="150" aria-label={terminal}>{terminal}</span>
    <span class="code" aria-hidden="true">MOD/{n} ®</span>
  </div>
  <div class="body">
    <span class="num" aria-hidden="true" data-reveal="left">{n}</span>
    <div class="txt">
      <Split as="h2" class="mtitle" text={titulo} />
      <Split as="p" class="mq" text={pregunta} delay={250} />
    </div>
  </div>
  <div class="barcode" aria-hidden="true">
    {[...barras, ...barras, ...barras].map((w, i) => <i style={`--w:${w}; --i:${i}`}></i>)}
  </div>
</section>

<style>
  .module { position: relative; background: var(--ink); color: var(--paper); border-top: var(--b); overflow: hidden; }
  .top { display: flex; justify-content: space-between; gap: 20px; padding: 14px var(--gutter); border-bottom: 1px solid #3a3a3a; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; min-height: 46px; }
  .code { color: var(--red); white-space: nowrap; }
  .body { display: flex; align-items: flex-end; gap: clamp(16px, 4vw, 56px); padding: clamp(50px, 8vw, 110px) var(--gutter) clamp(40px, 6vw, 80px); flex-wrap: wrap; }
  .num { display: inline-block; font-size: clamp(9rem, 30vw, 26rem); font-weight: 900; line-height: 0.75; letter-spacing: -0.08em; color: var(--red); font-stretch: 125%; }
  .txt { flex: 1; min-width: min(100%, 460px); padding-bottom: 1vw; }
  :global(.mtitle) { font-size: clamp(2.2rem, 5.2vw, 5rem); font-stretch: 112%; }
  :global(.mq) { margin-top: 18px; font: 500 clamp(0.95rem, 1.4vw, 1.15rem)/1.4 var(--mono); color: #c9c8c0; max-width: 40ch; text-transform: uppercase; letter-spacing: 0.02em; }
  .barcode { display: flex; gap: 4px; height: 34px; padding: 0 var(--gutter); border-top: 1px solid #3a3a3a; align-items: stretch; overflow: hidden; }
  .barcode i { flex: var(--w) 1 0; background: var(--paper); }
  .barcode i:nth-child(7n) { background: var(--red); }
  :global(html.motion) .barcode i { animation: scanbar 2.4s steps(2) infinite; animation-delay: calc(var(--i) * -0.17s); }
  @keyframes scanbar { 50% { opacity: 0.15; } }
</style>
