---
import Split from './Split.astro';
import { problema, agenda } from '../data/ejez';
---

<section id="problema" class="section">
  <div class="wrap">
    <p class="eyebrow" data-reveal="up">01 — El problema</p>
    <h2 class="title"><Split as="span" text="Hoy, el laboratorio" /> <span class="hl">hace esperar</span></h2>

    <div class="layout">
      <div class="card main" data-reveal="wipe">
        <p class="kicker">[ Espera promedio en cola ]</p>
        <p class="giant"><span data-count={problema.esperaHoras} data-dec="2">{problema.esperaHoras}</span><small>H</small></p>
        <p class="desc">antes de que un pedido empiece a imprimirse: unos <b class="red">{problema.dias} días</b> de laboratorio de 8 h.</p>
        <div class="clock" aria-hidden="true">
          {Array.from({ length: 17 }, (_, i) => <span style={`--i:${i}`}>{String(i + 1).padStart(2, '0')}</span>)}
        </div>
      </div>
      <div class="side">
        <div class="card glow" data-reveal="right" style="--d:100">
          <p class="kicker">Impresoras disponibles</p>
          <p class="big"><span data-count={problema.impresoras}>{problema.impresoras}</span></p>
        </div>
        <div class="card glow" data-reveal="right" style="--d:200">
          <p class="kicker">Pedidos que llegan por hora</p>
          <p class="big"><span data-count={problema.llegadas} data-dec="2">{problema.llegadas}</span></p>
        </div>
        <div class="card redbg" data-reveal="right" style="--d:300">
          <p class="kicker">Utilización — casi nunca hay una libre</p>
          <p class="big"><span data-count={problema.utilizacion} data-suf=" %">{problema.utilizacion} %</span></p>
          <div class="meter" aria-hidden="true"><span data-grow="x" style={`width:${problema.utilizacion}%`}></span></div>
        </div>
      </div>
    </div>
    <p class="source" data-reveal="up">Fuente: XLSX › Colas (B65–B72)</p>
  </div>
</section>

<section class="section agenda">
  <div class="wrap">
    <p class="eyebrow" data-reveal="up">Agenda</p>
    <Split as="h2" class="title" text="Del problema al retorno" />
  </div>
  <ol class="steps">
    {agenda.map((a, i) => (
      <li data-reveal="up" style={`--d:${i * 90}`}>
        <a href={a.href} class="step">
          <span class="sn">{a.n}</span>
          <span class="st">{a.titulo}</span>
          <span class="ss mono">{a.sub}</span>
          <span class="arr mono" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; margin-top: 48px; border: var(--b); }
  .main { border: 0; border-right: var(--b); display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
  .giant { font-size: clamp(5rem, 15vw, 13rem); font-weight: 900; line-height: 0.82; letter-spacing: -0.07em; font-stretch: 125%; font-variant-numeric: tabular-nums; }
  .giant small { font-size: 0.32em; color: var(--red); margin-left: 0.15em; letter-spacing: 0; }
  .desc { font-size: 1.15rem; font-weight: 600; max-width: 38ch; }
  .clock { display: grid; grid-template-columns: repeat(17, 1fr); border: var(--b); }
  .clock span { font: 600 9px/1 var(--mono); padding: 10px 0; text-align: center; border-right: 1px solid var(--ink); }
  .clock span:last-child { border-right: 0; }
  :global(html.motion) .clock span { animation: tick 3.4s steps(1) infinite; animation-delay: calc(var(--i) * 0.2s); }
  @keyframes tick { 0%, 100% { background: transparent; color: var(--ink); } 10%, 30% { background: var(--red); color: var(--paper); } }
  .side { display: grid; grid-template-rows: repeat(3, 1fr); }
  .side .card { border: 0; border-bottom: var(--b); display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
  .side .card:last-child { border-bottom: 0; }
  .meter { height: 14px; border: 2px solid var(--paper); }
  .meter span { display: block; height: 100%; background: var(--paper); transform-origin: 0 50%; }

  .agenda { padding-bottom: 0; }
  .steps { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); border-top: var(--b); }
  .steps li { border-right: var(--b); }
  .steps li:last-child { border-right: 0; }
  .step { position: relative; display: flex; flex-direction: column; gap: 8px; min-height: 240px; padding: 22px; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .step:hover { background: var(--red); color: var(--paper); }
  .sn { font-size: 3.4rem; font-weight: 900; line-height: 0.9; letter-spacing: -0.05em; font-stretch: 125%; }
  .st { margin-top: auto; font-size: 1.25rem; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1; }
  .ss { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; }
  .arr { position: absolute; top: 22px; right: 22px; font-size: 20px; transition: transform 0.2s var(--snap); }
  .step:hover .arr { transform: translateX(6px); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .main { border-right: 0; border-bottom: var(--b); }
    .clock span { font-size: 0; padding: 8px 0; }
    .steps { grid-template-columns: 1fr 1fr; }
    .steps li { border-bottom: var(--b); }
    .steps li:nth-child(2n) { border-right: 0; }
    .step { min-height: 170px; }
  }
</style>
